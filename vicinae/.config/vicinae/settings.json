{
  "$schema": "https://vicinae.com/schemas/config.json",
  "imports": [],
  "pop_on_backspace": true,
  "activate_on_single_click": false,
  "escape_key_behavior": "navigate_back",
  "keybinding": "default",
  "search_files_in_root": false,
  "input_server": {
    "enabled": true
  },
  "font": {
    "rendering": "qt",
    "normal": {}
  },
  "theme": {
    "light": {
      "name": "vicinae-light",
      "icon_theme": "auto"
    },
    "dark": {
      "name": "vicinae-dark",
      "icon_theme": "auto"
    }
  },
  "telemetry": {
    "system_info": false
  },
  "launcher_window": {
    "rounding": 10,
    "compact_mode": {
      "enabled": true
    },
    "material": "auto",
    "clock": {
      "enabled": true,
      "interval": 60
    }
  },
  "keybinds": {},
  "favorites": ["clipboard:history"],
  "fallbacks": ["files:search"],
  "providers": {
    "applications": {
      "entrypoints": {
        "com.mitchellh.ghostty": {
          "alias": "term"
        },
        "dev.zed.Zed": {
          "alias": "zed"
        }
      }
    }
  }
}
